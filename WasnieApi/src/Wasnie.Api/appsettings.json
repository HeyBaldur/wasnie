{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/wasnie-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "http://localhost:4200"
  ],
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=WasnieDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "Secret": "REPLACE_WITH_A_STRONG_SECRET_KEY_AT_LEAST_32_CHARS",
    "Issuer": "WasnieApi",
    "Audience": "WasnieUi",
    "ExpiryMinutes": "15"
  },
  "Resend": {
    "ApiKey": "re_aBqdxPDq_37Mde89mt36B6e9Nja4dyvSf",
    "FromAddress": "Wasnie <onboarding@resend.dev>",
    "FrontendBaseUrl": "https://app.wasnie.com"
  },
  "Stripe": {
    "SecretKey": "REPLACE_WITH_STRIPE_SECRET_KEY",
    "PublishableKey": "REPLACE_WITH_STRIPE_PUBLISHABLE_KEY",
    "WebhookSecret": "REPLACE_WITH_STRIPE_WEBHOOK_SIGNING_SECRET",
    "FrontendBaseUrl": "http://localhost:4200",
    "ProductTierMap": {
      "prod_REPLACE_STARTER_PRODUCT_ID": "Starter",
      "prod_REPLACE_GROWTH_PRODUCT_ID": "Growth",
      "prod_REPLACE_SCALE_PRODUCT_ID": "Scale"
    }
  },
  "HubSpot": {
    "ClientId": "",
    "ClientSecret": "",
    "TokenEncryptionKey": "",
    "RedirectUri": "http://localhost:5091/api/integrations/hubspot/callback",
    "Scopes": "crm.objects.deals.read crm.objects.owners.read crm.schemas.deals.read",
    "AuthorizationEndpoint": "https://app.hubspot.com/oauth/authorize",
    "TokenEndpoint": "https://api.hubapi.com/oauth/v1/token",
    "ApiBaseUrl": "https://api.hubapi.com",
    "FrontendReturnUrl": "http://localhost:4200/integrations"
  },
  "Imports": {
    "TransactionMaxRows": 10000,
    "PayeeMaxRows": 300
  },
  "RateLimiting": {
    "AuthLogin": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "AuthRegister": {
      "PermitLimit": 3,
      "WindowSeconds": 60
    },
    "AuthRefresh": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Global": {
      "PermitLimit": 100,
      "WindowSeconds": 60
    }
  }
}
