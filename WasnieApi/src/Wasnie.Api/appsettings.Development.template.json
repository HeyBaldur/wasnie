{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SQL_SERVER_INSTANCE;Database=WasnieDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "Secret": "REPLACE_WITH_A_RANDOM_32_PLUS_CHAR_SECRET_DO_NOT_REUSE_FROM_PROD",
    "Issuer": "WasnieApi",
    "Audience": "WasnieUi",
    "ExpiryMinutes": "15"
  },
  "Stripe": {
    "SecretKey": "sk_test_REPLACE_WITH_YOUR_TEST_SECRET_KEY",
    "PublishableKey": "pk_test_REPLACE_WITH_YOUR_TEST_PUBLISHABLE_KEY"
  },
  "Groq": {
    "_comment": "The assistant's chat model. Leave ApiKey EMPTY here and put the real value in User Secrets: dotnet user-secrets set \"Groq:ApiKey\" \"<your key>\" (see README). With no key the assistant still works, answering with its stand-in reply.",
    "ApiKey": ""
  }
}
