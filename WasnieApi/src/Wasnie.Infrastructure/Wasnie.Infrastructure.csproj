<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Wasnie.Application\Wasnie.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.14" />
    <PackageReference Include="Hangfire.Core" Version="1.8.14" />
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.14" />
    <PackageReference Include="Stripe.net" Version="52.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.1" />
    <PackageReference Include="CsvHelper" Version="33.0.1" />
    <PackageReference Include="QuestPDF" Version="2025.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.0.2" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Wasnie.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Wasnie.UnitTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>


  <ItemGroup>
    <!--
      The assistant's knowledge, LINKED rather than copied: this is the same file the team edits and
      publishes the handbook from, so updating what the assistant knows is editing that document and
      rebuilding. A duplicate under this project would drift from the guide within a release, and an
      assistant confidently quoting last month's rules is worse than one that says it does not know.

      It lives HERE, beside FileAssistantKnowledgeBase which reads it, so it flows to the output of
      every project that references Infrastructure — the API and the test projects alike — from one
      declaration instead of one per consumer.
    -->
    <Content Include="..\..\..\docs\Wasnie_Configuration_Guide.md"
             Link="Knowledge\Wasnie_Configuration_Guide.md"
             CopyToOutputDirectory="PreserveNewest" />

    <!--
      The navigation map, linked the same way and for the same reason. It is a SEPARATE artefact from
      the guide on purpose: the guide documents business rules, this documents the app's routing, and
      the two change for different reasons — a UI redesign rewrites every route in here and not one
      rule in there.
    -->
    <Content Include="..\..\..\docs\UINavigationMap.json"
             Link="Knowledge\UINavigationMap.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
